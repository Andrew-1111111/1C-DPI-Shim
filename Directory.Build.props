<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <PlatformToolset>v143</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' &gt;= '18.0'">v145</PlatformToolset>
    <IntDir>$(SolutionDir)obj\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <CharacterSet>Unicode</CharacterSet>
    <OutDir Condition="'$(Configuration)'=='Release'">$(SolutionDir)bin\x86\</OutDir>
    <OutDir Condition="'$(Configuration)'=='Debug'">$(SolutionDir)bin\x86\debug\</OutDir>
  </PropertyGroup>
</Project>
