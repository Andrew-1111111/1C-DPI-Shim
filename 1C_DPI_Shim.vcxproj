    <Keyword>Win32Proj</Keyword>
    <RootNamespace>OneCDpiShim</RootNamespace>
    <ProjectName>1C_DPI_Shim</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType Condition="'$(BuildAsDll)'=='true'">DynamicLibrary</ConfigurationType>
    <ConfigurationType Condition="'$(BuildAsDll)'!='true'">Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType Condition="'$(BuildAsDll)'=='true'">DynamicLibrary</ConfigurationType>
    <ConfigurationType Condition="'$(BuildAsDll)'!='true'">Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <TargetName Condition="'$(BuildAsDll)'=='true'">1C_DPI_Shim</TargetName>
    <TargetName Condition="'$(BuildAsDll)'!='true'">1C-DPI-Shim</TargetName>
    <ShimDllDir>$(SolutionDir)obj\shim\$(Platform)\$(Configuration)\</ShimDllDir>
    <ShimDllFile>$(ShimDllDir)1C_DPI_Shim.dll</ShimDllFile>
    <IntDir Condition="'$(BuildAsDll)'=='true'">$(ShimDllDir)</IntDir>
    <IntDir Condition="'$(BuildAsDll)'!='true'">$(SolutionDir)obj\launcher\$(Platform)\$(Configuration)\</IntDir>
    <OutDir Condition="'$(BuildAsDll)'=='true'">$(ShimDllDir)</OutDir>
    <ApplicationIcon Condition="'$(BuildAsDll)'!='true'">resources\app.ico</ApplicationIcon>
    <LocalDebuggerCommandArguments>225 --designer</LocalDebuggerCommandArguments>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>$(ProjectDir)source\common;$(ProjectDir)source\launcher;$(ProjectDir)source\shim;$(ProjectDir)source\minhook;$(ProjectDir)resources;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions Condition="'$(BuildAsDll)'=='true'">UNICODE;_UNICODE;WINVER=0x0A00;_WIN32_WINNT=0x0A00;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(BuildAsDll)'!='true'">UNICODE;_UNICODE;WINVER=0x0A00;_WIN32_WINNT=0x0A00;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Platform)'=='Win32'">WIN32;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Release'">NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreaded</RuntimeLibrary>
      <FunctionLevelLinking Condition="'$(Configuration)'=='Release'">true</FunctionLevelLinking>
      <IntrinsicFunctions Condition="'$(Configuration)'=='Release'">true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <SubSystem Condition="'$(BuildAsDll)'=='true'">Windows</SubSystem>
      <SubSystem Condition="'$(BuildAsDll)'!='true'">Console</SubSystem>
      <ImportLibrary Condition="'$(BuildAsDll)'=='true'">$(IntDir)$(TargetName).lib</ImportLibrary>
      <GenerateDebugInformation Condition="'$(Configuration)'=='Debug'">true</GenerateDebugInformation>
      <GenerateDebugInformation Condition="'$(Configuration)'=='Release'">false</GenerateDebugInformation>
      <EnableCOMDATFolding Condition="'$(Configuration)'=='Release'">true</EnableCOMDATFolding>
      <OptimizeReferences Condition="'$(Configuration)'=='Release'">true</OptimizeReferences>
      <LinkTimeCodeGeneration Condition="'$(Configuration)'=='Release'">UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
    </Link>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)resources;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <PostBuildEvent Condition="'$(BuildAsDll)'!='true'">
      <Command>if not exist "$(OutDir)" mkdir "$(OutDir)"
copy /Y "$(ProjectDir)config\1c-dpi.ini" "$(OutDir)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="source\launcher\main.cpp">
      <ExcludedFromBuild Condition="'$(BuildAsDll)'=='true'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="source\launcher\payload.cpp">
      <ExcludedFromBuild Condition="'$(BuildAsDll)'=='true'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="source\launcher\console.cpp">
      <ExcludedFromBuild Condition="'$(BuildAsDll)'=='true'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="source\launcher\onec_locator.cpp">
      <ExcludedFromBuild Condition="'$(BuildAsDll)'=='true'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="source\common\inject.cpp" />
    <ClCompile Include="source\common\process_utils.cpp" />
    <ClCompile Include="source\common\io.cpp" />
    <ClCompile Include="source\shim\dllmain.cpp">
      <ExcludedFromBuild Condition="'$(BuildAsDll)'!='true'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="source\shim\dpi_shim.cpp">
      <ExcludedFromBuild Condition="'$(BuildAsDll)'!='true'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="source\shim\dpi_hooks.cpp">
      <ExcludedFromBuild Condition="'$(BuildAsDll)'!='true'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="source\shim\logging.cpp">
      <ExcludedFromBuild Condition="'$(BuildAsDll)'!='true'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="source\minhook\buffer.c">
      <ExcludedFromBuild Condition="'$(BuildAsDll)'!='true'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="source\minhook\hook.c">
      <ExcludedFromBuild Condition="'$(BuildAsDll)'!='true'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="source\minhook\trampoline.c">
      <ExcludedFromBuild Condition="'$(BuildAsDll)'!='true'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="source\minhook\hde\hde32.c">
      <ExcludedFromBuild Condition="'$(BuildAsDll)'!='true'">true</ExcludedFromBuild>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="source\launcher\launcher_args.h" />
    <ClInclude Include="source\launcher\payload.h" />
    <ClInclude Include="source\launcher\console.h" />
    <ClInclude Include="source\launcher\onec_locator.h" />
    <ClInclude Include="resources\resource.h" />
    <ClInclude Include="source\common\inject.h" />
    <ClInclude Include="source\common\dpi_math.h" />
    <ClInclude Include="source\common\process_utils.h" />
    <ClInclude Include="source\common\io.h" />
    <ClInclude Include="source\shim\dpi_shim.h" />
    <ClInclude Include="source\shim\dpi_hooks.h" />
    <ClInclude Include="source\shim\logging.h" />
    <ClInclude Include="source\minhook\MinHook.h" />
    <ClInclude Include="source\minhook\buffer.h" />
    <ClInclude Include="source\minhook\trampoline.h" />
