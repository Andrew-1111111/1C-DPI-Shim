  </ItemGroup>
  <ItemGroup>
    <None Include="config\1c-dpi.ini" />
    <None Include="source\minhook\LICENSE.txt" />
    <None Include="source\minhook\AUTHORS.txt" />
    <None Include="resources\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="resources\app.rc">
      <ExcludedFromBuild Condition="'$(BuildAsDll)'=='true'">true</ExcludedFromBuild>
    </ResourceCompile>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="BuildShimDll" BeforeTargets="PrepareForBuild" Condition="'$(BuildAsDll)'!='true' And '$(DesignTimeBuild)'!='true'">
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="Build" Properties="BuildAsDll=true;Configuration=$(Configuration);Platform=$(Platform);ConfigurationType=DynamicLibrary;TargetName=1C_DPI_Shim;OutDir=$(ShimDllDir);IntDir=$(ShimDllDir)" />
  </Target>
  <Target Name="GeneratePayloadRc" BeforeTargets="ResourceCompile" DependsOnTargets="BuildShimDll" Condition="'$(BuildAsDll)'!='true' And '$(DesignTimeBuild)'!='true'" Inputs="$(ShimDllFile)" Outputs="$(IntDir)shim_payload.rc">
    <MakeDir Directories="$(IntDir)" />
    <PropertyGroup>
      <_ShimDllUnix>$(ShimDllFile.Replace('\', '/'))</_ShimDllUnix>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntDir)shim_payload.rc" Lines="SHIMPAYLOAD RCDATA &quot;$(_ShimDllUnix)&quot;" Overwrite="true" Encoding="ASCII" />
    <Touch Files="$(IntDir)shim_payload.rc" />
  </Target>
  <ItemGroup Condition="'$(BuildAsDll)'!='true'">
    <ResourceCompile Include="$(IntDir)shim_payload.rc" />
  </ItemGroup>
  <Target Name="CleanShimDll" BeforeTargets="Clean" Condition="'$(BuildAsDll)'!='true' And '$(DesignTimeBuild)'!='true'">
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="Clean" Properties="BuildAsDll=true;Configuration=$(Configuration);Platform=$(Platform);ConfigurationType=DynamicLibrary;TargetName=1C_DPI_Shim;OutDir=$(ShimDllDir);IntDir=$(ShimDllDir)" />
  </Target>
</Project>
